+// The daily sign-in: what Tabbit's own answers come to.
+
+import test from "node:test"
+import assert from "node:assert/strict"
+import { checkinOf, _internal } from "../src/checkin.mjs"
+
+const creds = { header: "token=t; user_id=u", token: "t", uid: "u" }
+
+// stub answers the status and the sign-in with what the test wants.
+function stub({ status, claim } = {}) {
+  const calls = []
+  const original = globalThis.fetch
+  globalThis.fetch = async (input, init = {}) => {
+    const url = new URL(typeof input === "string" ? input : input.url)
+    calls.push({ path: url.pathname, query: url.search, method: init.method ?? "GET", body: init.body })
+    if (url.pathname.endsWith("/sign-in/status")) return Response.json(status ?? {})
+    if (url.pathname.endsWith("/sign-in")) return Response.json(claim ?? {})
+    return new Response("nope", { status: 404 })
+  }
+  return { calls, restore: () => (globalThis.fetch = original) }
+}
+
+const open = (extra) => ({
+  sign_in_date: "2026-11-03",
+  results: [{ scene_code: "desktop_pet", activity_open: true, signed_today: false, signed_days: 0, total_signed_days: 0, required_days: 3, usage_reward_result: null, pet_entitlement_result: "not_eligible", ...extra }],
+})
+
+test("a day already signed is 'done', and nothing is claimed", async () => {
+  const { calls, restore } = stub({ status: open({ signed_today: true, signed_days: 1 }) })
+  try {
+    const out = await checkinOf(creds)
+    assert.equal(out.outcome, "done")
+    assert.equal(out.streak, 1)
+    assert.equal(calls.filter((c) => c.method === "POST").length, 0)
+  } finally {
+    restore()
+  }
+})
+
+test("a fresh day is claimed, with the request number Tabbit wants", async () => {
+  const { calls, restore } = stub({
+    status: open(),
+    claim: { sign_in_date: "2026-11-03", results: [{ scene_code: "desktop_pet", activity_open: true, sign_in_result: "signed", signed_days: 1, required_days: 3, usage_reward_result: { amount: 5 } }] },
+  })
+  try {
+    const out = await checkinOf(creds)
+    assert.equal(out.outcome, "claimed")
+    assert.equal(out.credit, 5)
+    assert.equal(out.streak, 1)
+    const post = calls.find((c) => c.method === "POST")
+    const body = JSON.parse(post.body)
+    assert.deepEqual(body.scene_codes, ["desktop_pet"])
+    assert.match(body.request_no, /^[0-9a-f-]{36}$/)
+  } finally {
+    restore()
+  }
+})
+
+test("a race that lands on 'already_signed' is 'done', not a failure", async () => {
+  const { restore } = stub({
+    status: open(),
+    claim: { results: [{ scene_code: "desktop_pet", activity_open: true, sign_in_result: "already_signed", signed_days: 1 }] },
+  })
+  try {
+    assert.equal((await checkinOf(creds)).outcome, "done")
+  } finally {
+    restore()
+  }
+})
+
+test("a closed activity is 'inactive'", async () => {
+  const { restore } = stub({ status: { results: [{ scene_code: "desktop_pet", activity_open: false, signed_today: false }] } })
+  try {
+    assert.equal((await checkinOf(creds)).outcome, "inactive")
+  } finally {
+    restore()
+  }
+})
+
+test("no result for the scene is 'ineligible'", async () => {
+  const { restore } = stub({ status: { sign_in_date: "2026-11-03", results: [] } })
+  try {
+    assert.equal((await checkinOf(creds)).outcome, "ineligible")
+  } finally {
+    restore()
+  }
+})
+
+test("a word this file hasn't seen is reported, not guessed as a success", async () => {
+  const { restore } = stub({ status: open(), claim: { results: [{ scene_code: "desktop_pet", sign_in_result: "throttled" }] } })
+  try {
+    const out = await checkinOf(creds)
+    assert.equal(out.outcome, "failed")
+    assert.match(out.message, /throttled/)
+  } finally {
+    restore()
+  }
+})
+
+test("a refused sign-in throws with magpie's expired mark", async () => {
+  const original = globalThis.fetch
+  globalThis.fetch = async () => new Response(JSON.stringify({ detail: "invalid bearer token" }), { status: 401 })
+  try {
+    await assert.rejects(() => checkinOf(creds), (error) => error.signIn === "expired")
+  } finally {
+    globalThis.fetch = original
+  }
+})
+
+test("the status call asks for the scene the service takes", async () => {
+  const { calls, restore } = stub({ status: open({ signed_today: true }) })
+  try {
+    await checkinOf(creds)
+    assert.match(calls[0].query, /scene_codes=desktop_pet/)
+  } finally {
+    restore()
+  }
+})
+
+test("a reward's number is read out of whatever shape it arrives in", () => {
+  assert.equal(_internal.rewardOf({ usage_reward_result: { amount: 3 } }), 3)
+  assert.equal(_internal.rewardOf({ usage_reward_result: { credit: "7" } }), 7)
+  assert.equal(_internal.rewardOf({ usage_reward_result: 12 }), 12)
+  assert.equal(_internal.rewardOf({ usage_reward_result: null }), undefined)
+  assert.equal(_internal.rewardOf({}), undefined)
+})
diff --git a/packages/tabbit/tests/cookie.test.mjs b/packages/tabbit/tests/cookie.test.mjs
new file mode 100644
index 0000000..390d4ed
--- /dev/null
+++ b/packages/tabbit/tests/cookie.test.mjs
@@ -0,0 +1,130 @@
+// The cookie store: a synthetic Chromium v10 blob, decrypted with a known
+// password, and the store lookup that finds the file.
+
+import test from "node:test"
+import assert from "node:assert/strict"
+import crypto from "node:crypto"
+import fs from "node:fs"
+import os from "node:os"
+import path from "node:path"
+import { decryptValue, cookieStore, copyStore, profileDirs, readCookies, desktopSignIn } from "../src/cookie.mjs"
+
+const HOST = "web.tabbit.com"
+const PASSWORD = "test-password"
+
+// seal makes the blob Chromium's own macOS encryption makes: AES-128-CBC
+// under the keychain password, `v10`, a 32-byte SHA-256 of the host in
+// front of the plaintext, and PKCS#7 padding.
+function seal(plaintext, { password = PASSWORD, host = HOST } = {}) {
+  const key = crypto.pbkdf2Sync(password, "saltysalt", 1003, 16, "sha1")
+  const body = Buffer.concat([crypto.createHash("sha256").update(host).digest(), Buffer.from(plaintext, "utf8")])
+  const pad = 16 - (body.length % 16)
+  const padded = Buffer.concat([body, Buffer.alloc(pad, pad)])
+  const cipher = crypto.createCipheriv("aes-128-cbc", key, Buffer.alloc(16, 0x20))
+  cipher.setAutoPadding(false)
+  return Buffer.concat([Buffer.from("v10", "latin1"), cipher.update(padded), cipher.final()])
+}
+
+test("a v10 blob decrypts to the plaintext", () => {
+  const token = "eyJhbGciOiJSUzI1NiJ9.payload.sig"
+  assert.equal(decryptValue(seal(token), { password: PASSWORD }), token)
+})
+
+test("the wrong password does not yield a plausible value", () => {
+  let value = null
+  try {
+    value = decryptValue(seal("hello"), { password: "wrong" })
+  } catch {
+    /* a wrong key usually throws on the padding */
+  }
+  assert.notEqual(value, "hello")
+})
+
+test("a blob that isn't v10 is refused", () => {
+  assert.throws(() => decryptValue(Buffer.from("v20xxxx"), { password: PASSWORD }), /unsupported cookie encryption/)
+})
+
+test("profileDirs honours an explicit override first", () => {
+  const dirs = profileDirs({ TABBIT_PROFILE_DIR: "/tmp/one" }, "/home/u")
+  assert.equal(dirs[0], "/tmp/one")
+})
+
+test("cookieStore finds Default/Cookies under a profile root", () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "tabbit-test-"))
+  fs.mkdirSync(path.join(root, "Default"), { recursive: true })
+  fs.writeFileSync(path.join(root, "Default", "Cookies"), "")
+  assert.equal(cookieStore([root]), path.join(root, "Default", "Cookies"))
+  assert.equal(cookieStore([path.join(root, "missing")]), null)
+})
+
+test("copyStore copies the database and its WAL", () => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "tabbit-test-"))
+  const file = path.join(root, "Cookies")
+  fs.writeFileSync(file, "db")
+  fs.writeFileSync(file + "-wal", "wal")
+  const copy = copyStore(file, fs.mkdtempSync(path.join(os.tmpdir(), "tabbit-copy-")))
+  assert.equal(fs.readFileSync(copy, "utf8"), "db")
+  assert.equal(fs.readFileSync(copy + "-wal", "utf8"), "wal")
+})
+
+test("readCookies reads token and user_id back out of a real sqlite file", () => {
+  let DatabaseSync
+  try {
+    DatabaseSync = globalThis.process.getBuiltinModule("node:sqlite").DatabaseSync
+  } catch {
+    return // older Node: the plugin says so at runtime too
+  }
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "tabbit-test-"))
+  const file = path.join(root, "Cookies")
+  const db = new DatabaseSync(file)
+  db.exec("create table cookies(host_key text, name text, value text, encrypted_value blob)")
+  db.prepare("insert into cookies values (?,?,?,?)").run(HOST, "token", "", seal("tok-123"))
+  db.prepare("insert into cookies values (?,?,?,?)").run(HOST, "user_id", "u-1", Buffer.alloc(0))
+  db.close()
+  const rows = readCookies(file)
+  const token = rows.find((r) => r.name === "token")
+  assert.equal(decryptValue(token.encrypted, { password: PASSWORD }), "tok-123")
+  assert.equal(rows.find((r) => r.name === "user_id").value, "u-1")
+})
+
+// ---- review round: the temp copy must not survive a sign-in ---------------
+
+function storeWith(token) {
+  let DatabaseSync
+  try {
+    DatabaseSync = globalThis.process.getBuiltinModule("node:sqlite").DatabaseSync
+  } catch {
+    return null
+  }
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "tabbit-store-"))
+  const file = path.join(root, "Cookies")
+  const db = new DatabaseSync(file)
+  db.exec("create table cookies(host_key text, name text, value text, encrypted_value blob)")
+  if (token) db.prepare("insert into cookies values (?,?,?,?)").run(HOST, "token", "", seal(token))
+  db.prepare("insert into cookies values (?,?,?,?)").run(HOST, "user_id", "u-9", Buffer.alloc(0))
+  db.close()
+  return file
+}
+
+test("a successful desktop sign-in leaves no copy of the cookie store", () => {
+  const file = storeWith("tok-desktop")
+  if (!file) return
+  const parent = fs.mkdtempSync(path.join(os.tmpdir(), "tabbit-parent-"))
+  const sign = desktopSignIn({ store: file, password: PASSWORD, tmpParent: parent, platform: "darwin" })
+  assert.match(sign.key, /token=tok-desktop/)
+  assert.equal(sign.userId, "u-9")
+  assert.deepEqual(fs.readdirSync(parent), [])
+})
+
+test("a failed desktop sign-in leaves no copy either", () => {
+  const file = storeWith(null)
+  if (!file) return
+  const parent = fs.mkdtempSync(path.join(os.tmpdir(), "tabbit-parent-"))
+  assert.throws(() => desktopSignIn({ store: file, password: PASSWORD, tmpParent: parent, platform: "darwin" }), /not signed in/)
+  assert.deepEqual(fs.readdirSync(parent), [])
+})
+
+test("the desktop method is macOS-only, and says so elsewhere", () => {
+  assert.throws(() => desktopSignIn({ store: "/nonexistent/Cookies", platform: "linux" }), /macOS-only/)
+  assert.throws(() => desktopSignIn({ store: "/nonexistent/Cookies", platform: "win32" }), /macOS-only/)
+})
diff --git a/packages/tabbit/tests/models.test.mjs b/packages/tabbit/tests/models.test.mjs
